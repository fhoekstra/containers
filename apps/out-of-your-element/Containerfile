# entrypoint.sh (vendored from melody's oci-images, patched for read-only
# root filesystems) is copied into the upstream source checkout by build.sh
# before building, because the build context is the cloned source tree.
FROM node:alpine AS builder

ENV NODE_ENV=production
WORKDIR /usr/src/app
COPY --chown=node:node . .
RUN apk add --no-cache python3 make build-base \
  && npm ci

FROM node:alpine AS runner
COPY --chmod=0755 entrypoint.sh /entrypoint.sh
WORKDIR /usr/src/app
COPY --chown=node:node --from=builder /usr/src/app/ .

USER node
ENTRYPOINT ["/entrypoint.sh"]
